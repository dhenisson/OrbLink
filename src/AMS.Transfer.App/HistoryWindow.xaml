<Window x:Class="AMS.Transfer.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Histórico — OrbLink" Width="880" Height="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Histórico de transferências" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource CardBrush}" AlternatingRowBackground="#182335"
                  BorderBrush="{DynamicResource LineBrush}" GridLinesVisibility="None" HeadersVisibility="Column"
                  CanUserAddRows="False" RowHeight="38">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#25364D"/>
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Arquivo" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Direção" Binding="{Binding Direction}" Width="90"/>
                <DataGridTextColumn Header="Computador" Binding="{Binding RemoteDeviceName}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="95"/>
                <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
