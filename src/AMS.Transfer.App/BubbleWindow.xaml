<Window x:Class="AMS.Transfer.App.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="OrbLink" Width="68" Height="68" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" AllowDrop="True"
        DragEnter="OnDragEnter" DragLeave="OnDragLeave" DragOver="OnDragOver" Drop="OnDrop"
        MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5"
          MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
        <Grid.RenderTransform><ScaleTransform x:Name="Scale"/></Grid.RenderTransform>
        <Border x:Name="Bubble" Margin="9" CornerRadius="100" Background="{DynamicResource OrbBackgroundBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <Border.Effect><DropShadowEffect x:Name="Glow" Color="#55A5FF" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
            <Grid>
                <Ellipse x:Name="Halo" Stroke="#3055A5FF" StrokeThickness="1.5" Margin="4"/>
                <Image x:Name="OrbIcon" Source="{StaticResource OrbLinkLogo}" Width="30" Height="30" Stretch="Uniform"/>
                <StackPanel x:Name="DropContent" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="SOLTE AQUI" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ProgressLabel" Foreground="White" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#79899F" Stroke="#101824" StrokeThickness="2"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"/>
        <Border x:Name="Badge" Background="{DynamicResource AccentBrush}" CornerRadius="9" MinWidth="19" Height="19"
                BorderBrush="#15213A" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="Collapsed">
            <TextBlock x:Name="BadgeText" Foreground="#0C192D" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
        </Border>
    </Grid>
</Window>
