<Window x:Class="AMS.Transfer.App.TextSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Enviar texto — OrbLink" Width="450" Height="320" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Enviar texto para o computador pareado" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBox x:Name="MessageTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="SendButton" Content="Enviar" Click="OnSend" Style="{StaticResource PrimaryButton}" Padding="18,7"/>
        </StackPanel>
    </Grid>
</Window>
