<Window x:Class="AMS.Transfer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Configurações · OrbLink" Width="670" Height="630" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Border CornerRadius="20" Margin="10" Background="{DynamicResource PanelBrush}" BorderBrush="#405589BF" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,22" MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel>
                    <TextBlock Text="Configurações" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="Deixe o OrbLink do seu jeito." Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="✕" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnClose"/>
            </Grid>
            <Grid Grid.Row="1" Margin="16,0,24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ListBox x:Name="Sections" SelectionChanged="OnSectionChanged" Margin="0,0,16,0">
                    <ListBoxItem Content="Geral" Padding="12,10"/>
                    <ListBoxItem Content="Aparência" Padding="12,10"/>
                    <ListBoxItem Content="Atalhos" Padding="12,10"/>
                    <ListBoxItem Content="Dispositivos" Padding="12,10"/>
                    <ListBoxItem Content="Sobre" Padding="12,10"/>
                </ListBox>
                <ScrollViewer x:Name="AppearanceScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
                            <TextBlock Text="Geral" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <CheckBox x:Name="StartupCheck" Content="Iniciar OrbLink com o Windows"/>
                            <TextBlock Text="A orb fica acessível sem manter uma janela grande aberta." Style="{StaticResource Caption}" Margin="0,8,0,20"/>
                            <TextBlock Text="Rede local" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Seus arquivos vão diretamente de um computador ao outro. Os pares e o histórico existentes são mantidos." Style="{StaticResource Caption}" Margin="0,8,0,0" LineHeight="20"/>
                        </StackPanel>
                        <StackPanel x:Name="AppearanceSection">
                            <TextBlock Text="Aparência" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid Width="88" Height="88" HorizontalAlignment="Left">
                                        <Border x:Name="PreviewOrb" Width="66" Height="66" CornerRadius="100" Background="#152541" BorderBrush="#55A5FF" BorderThickness="1">
                                            <Border.Effect><DropShadowEffect x:Name="PreviewShadow" Color="#55A5FF" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                                            <Image x:Name="PreviewIcon" Source="{StaticResource OrbLinkLogo}" Width="30" Height="30" Stretch="Uniform"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Sua orb, seu estilo" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock x:Name="IconDescription" Text="Ícone padrão do OrbLink" Style="{StaticResource Caption}" Margin="0,5,0,9"/>
                                        <WrapPanel>
                                            <Button Content="Escolher PNG / ICO" Click="OnChooseIcon" Style="{StaticResource PrimaryButton}" FontSize="11" Padding="9,7" Margin="0,0,6,4"/>
                                            <Button Content="Restaurar padrão" Click="OnResetIcon" FontSize="11" Padding="9,7" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="PNG transparente e ICO · até 4 MB" Style="{StaticResource Caption}" FontSize="10" Margin="0,8,0,17"/>
                            <TextBlock Text="Cor de destaque" Style="{StaticResource SectionTitle}" Margin="0,0,0,9"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Background="#55A5FF" Width="30" Height="30" Tag="#55A5FF" Click="OnAccent" ToolTip="Azul" Margin="0,0,8,0"/>
                                <Button Background="#9785FF" Width="30" Height="30" Tag="#9785FF" Click="OnAccent" ToolTip="Violeta" Margin="0,0,8,0"/>
                                <Button Background="#4ED8CB" Width="30" Height="30" Tag="#4ED8CB" Click="OnAccent" ToolTip="Turquesa" Margin="0,0,8,0"/>
                                <Button Background="#F18FAE" Width="30" Height="30" Tag="#F18FAE" Click="OnAccent" ToolTip="Rosa" Margin="0,0,8,0"/>
                                <TextBox x:Name="AccentText" Width="100" TextChanged="OnPreviewChanged" MaxLength="7"/>
                            </StackPanel>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Tamanho da orb" Style="{StaticResource Caption}"/>
                                    <Slider x:Name="OrbSizeSlider" Minimum="52" Maximum="100" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding Value, ElementName=OrbSizeSlider, StringFormat={}{0:0} px}" Style="{StaticResource Caption}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tamanho do ícone" Style="{StaticResource Caption}"/>
                                    <Slider x:Name="IconSizeSlider" Minimum="16" Maximum="56" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding Value, ElementName=IconSizeSlider, StringFormat={}{0:0} px}" Style="{StaticResource Caption}" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Opacidade do painel" Style="{StaticResource Caption}"/>
                                    <Slider x:Name="OpacitySlider" Minimum="0.82" Maximum="1" ValueChanged="OnSliderChanged" Margin="0,10,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Intensidade do glow" Style="{StaticResource Caption}"/>
                                    <Slider x:Name="ShadowSlider" Minimum="0" Maximum="1" ValueChanged="OnSliderChanged" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,16,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Fundo da orb" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BackgroundText" Grid.Column="1" TextChanged="OnPreviewChanged" MaxLength="7"/>
                            </Grid>
                            <CheckBox x:Name="BorderCheck" Content="Mostrar borda" Checked="OnPreviewChanged" Unchecked="OnPreviewChanged"/>
                            <CheckBox x:Name="AutoHideCheck" Content="Semiocultar nas laterais"/>
                            <CheckBox x:Name="AnimationsCheck" Content="Animações suaves"/>
                            <CheckBox x:Name="SoundCheck" Content="Som ao receber um item"/>
                            <TextBlock Text="Tema escuro · cores e estilos organizados para futuros temas." Style="{StaticResource Caption}" FontSize="10" Margin="0,12,0,16"/>
                        </StackPanel>
                        <StackPanel x:Name="ShortcutsSection" Visibility="Collapsed">
                            <TextBlock Text="Atalhos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                            <TextBlock Text="Ctrl + V" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Cola e envia a imagem atual quando o painel do OrbLink está ativo." Style="{StaticResource Caption}" Margin="0,8,0,20" LineHeight="20"/>
                            <TextBlock Text="Esc" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Fecha o painel." Style="{StaticResource Caption}" Margin="0,8,0,20"/>
                            <TextBlock Text="Clique + arraste" Foreground="{DynamicResource AccentBrush}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Move a orb ou leva um item recebido para outro programa." Style="{StaticResource Caption}" Margin="0,8,0,0" LineHeight="20"/>
                        </StackPanel>
                        <StackPanel x:Name="DevicesSection" Visibility="Collapsed">
                            <TextBlock Text="Dispositivos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock x:Name="LocalDeviceText" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Encontre e autorize computadores na mesma rede local." Style="{StaticResource Caption}" Margin="0,10,0,20"/>
                            <Button Content="Gerenciar computadores" Click="OnDevices" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                            <Image Source="{StaticResource OrbLinkLogo}" Width="60" Height="60" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Text="OrbLink" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="Versão 0.3.0 · Beta pública · Windows x64" Style="{StaticResource Caption}" Margin="0,8,0,22"/>
                            <TextBlock Text="Arraste. Solte. Receba." FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Compartilhe arquivos, imagens e textos entre seus computadores, direto pela rede local." Style="{StaticResource Caption}" Margin="0,12,0,0" LineHeight="22"/>
                            <TextBlock Text="Licença MIT · consulte LICENSE.txt na distribuição. GitHub e atualização automática: em preparação." Style="{StaticResource Caption}" Margin="0,16,0,0" LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="As alterações são aplicadas ao salvar." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="SaveButton" Grid.Column="1" Content="Salvar alterações" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
