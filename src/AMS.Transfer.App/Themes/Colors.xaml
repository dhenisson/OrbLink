<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#55A5FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#192E527F"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#101824"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F7101824"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1B293C"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#22344D"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2B3A51"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EEF4FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AAAC0"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#72839C"/>
    <SolidColorBrush x:Key="OnlineBrush" Color="#5CDEAA"/>
    <SolidColorBrush x:Key="OrbBackgroundBrush" Color="#152541"/>
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
</ResourceDictionary>
