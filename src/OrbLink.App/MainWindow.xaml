<Window x:Class="OrbLink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="OrbLink" Width="414" Height="570" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated">
    <Border Margin="10" CornerRadius="22" Background="{DynamicResource PanelBrush}"
            BorderBrush="#405589BF" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.32" Color="#050A15"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="22,22,18,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}" BorderBrush="#40639BD4" BorderThickness="1" HorizontalAlignment="Left">
                    <Image Source="{StaticResource OrbLinkLogo}" Width="28" Height="28"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="OrbLink" FontSize="22" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{DynamicResource SubtleBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ConnectionText" Text="Nenhum computador online" Style="{StaticResource Caption}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Style="{StaticResource QuietButton}" Click="OnClose" Padding="8" VerticalAlignment="Top"
                        ToolTip="Fechar painel" AutomationProperties.Name="Fechar painel"/>
            </Grid>
            <Grid Grid.Row="1" Margin="22,0" ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Recebidos recentemente" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="ItemCount" Foreground="{DynamicResource SubtleBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>
                <ListBox x:Name="InboxList" Grid.Row="1" PreviewMouseLeftButtonDown="OnItemMouseDown" PreviewMouseMove="OnItemMouseMove">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" CornerRadius="13" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="9" Background="#152337" HorizontalAlignment="Left" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="44"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Record.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.Name}"/>
                                            <TextBlock Text="{Binding Origin}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <UniformGrid Columns="3" Margin="0,12,0,0">
                                        <Button Content="{Binding CopyLabel}" Click="OnCopy" Padding="5,7" FontSize="10" Margin="0,0,5,0"/>
                                        <Button Content="Abrir" Click="OnOpen" Padding="5,7" FontSize="10" Margin="0,0,5,0"/>
                                        <Button Content="Arrastar" Padding="5,7" FontSize="10" ToolTip="Clique, segure e arraste para outro programa"
                                                PreviewMouseLeftButtonDown="OnDragButtonDown" PreviewMouseMove="OnDragButtonMove"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid x:Name="EmptyState" Grid.Row="1" Margin="10,6,10,10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="280">
                        <Grid Width="104" Height="98" Margin="0,0,0,15">
                            <Ellipse Width="94" Height="94" Stroke="#183E6A" StrokeThickness="1"/>
                            <Ellipse Width="72" Height="72" Stroke="#23496F" StrokeThickness="1" Fill="#101E32"/>
                            <Border Width="52" Height="52" CornerRadius="18" Background="#1D3759" BorderBrush="#3D6D9D" BorderThickness="1">
                                <Image Source="{StaticResource OrbLinkLogo}" Width="35" Height="35"/>
                            </Border>
                            <Border Width="25" Height="25" CornerRadius="9" Background="#264E7E" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,8">
                                <TextBlock Text="+" Foreground="#B4DCFF" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Nada por aqui ainda" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="Arraste um arquivo para a orb ou pressione Ctrl+V para enviar uma imagem."
                                   Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,10,0,0" LineHeight="20"/>
                        <Border Background="#17263B" CornerRadius="7" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="10,5">
                            <TextBlock Text="Ctrl + V   ·   Colar imagem" FontSize="11" Foreground="#B9CFE9"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="#102139" BorderBrush="#253F60" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image x:Name="PastePreview" Width="30" Height="30" Margin="0,0,10,0" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FeedbackText" Text="Tudo pronto para compartilhar" FontSize="11" Foreground="#B9CDE7" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="SendProgress" Height="3" Margin="0,6,0,0" Maximum="100" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Button Grid.Column="1" Content="Texto" Click="OnSendText" Style="{StaticResource QuietButton}" FontSize="11" Padding="8,5" Margin="8,0,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Row="3" Padding="12,10,12,14">
                <UniformGrid Columns="4">
                    <Button Click="OnDevices" Style="{StaticResource QuietButton}" Padding="3,8">
                        <StackPanel><TextBlock Text="&#xE8CE;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,7"/><TextBlock Text="Computadores" FontSize="10"/></StackPanel>
                    </Button>
                    <Button x:Name="PasteButton" Click="OnPasteImage" Style="{StaticResource QuietButton}" Padding="3,8" ToolTip="Colar e enviar imagem (Ctrl+V)">
                        <StackPanel><TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,7"/><TextBlock Text="Colar imagem" FontSize="10"/></StackPanel>
                    </Button>
                    <Button Click="OnHistory" Style="{StaticResource QuietButton}" Padding="3,8">
                        <StackPanel><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,7"/><TextBlock Text="Histórico" FontSize="10"/></StackPanel>
                    </Button>
                    <Button Click="OnSettings" Style="{StaticResource QuietButton}" Padding="3,8">
                        <StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,7"/><TextBlock Text="Configurações" FontSize="10"/></StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
