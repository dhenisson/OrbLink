<Window x:Class="OrbLink.App.DevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Computadores — OrbLink" Width="510" Height="410" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Computadores na rede" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <ListBox x:Name="DevicesList" Grid.Row="1" DisplayMemberPath="Display" Background="{DynamicResource CardBrush}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0"/>
            <Button x:Name="RefreshButton" Content="Atualizar" Click="OnRefresh" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="PairButton" Content="Parear" Click="OnPair" Style="{StaticResource PrimaryButton}" Padding="18,6"/>
        </StackPanel>
    </Grid>
</Window>
